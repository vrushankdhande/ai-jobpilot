# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_NAME=AI JobPilot
# development | staging | production
APP_ENV=development
DEBUG=true

# --- Backend (FastAPI) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Web dashboard (React; served by web/server/server.mjs) ---
# The web server forwards /api to this URL and adds ADMIN_TOKEN itself: the token is never sent to the browser.
BACKEND_BASE_URL=http://127.0.0.1:8000
# Local default 8502 (8501 is Streamlit's usual port and often taken). WEB_HOST 127.0.0.1 keeps it local. Read by the Node server from this file.
WEB_PORT=8502
WEB_HOST=127.0.0.1

# --- MongoDB ---
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=ai_jobpilot

# --- Resume intelligence (Phase 2) ---
# Uploaded resumes are stored here (relative to the project root). Never exposed over HTTP.
RESUME_STORAGE_DIR=storage/resumes
MAX_UPLOAD_MB=10
# Below this many extracted characters a document is treated as empty/scanned
MIN_RESUME_TEXT_CHARS=100
# Keep the extracted resume text in MongoDB (needed for fact-checking edits)
STORE_RESUME_TEXT=true
# Optional AI-assisted extraction. OFF by default; resume parsing works without it.
# Enabling it SENDS RESUME TEXT TO THE ANTHROPIC API. Requires both settings:
AI_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-sonnet-5-5

# --- AI provider (optional) ---
# anthropic (Claude) or gemini (Google AI Studio key from https://aistudio.google.com/api-keys). The key is read from THIS file only.
# Everything below that says "Claude" or "Anthropic" applies to the selected provider: its key, and the consent flags, decide what is sent.
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- AI matching (Phase 3) ---
# Matching and eligibility work WITHOUT Claude (deterministic rules). Claude is used only when ALL of:
#   ENABLE_AI_MATCHING=true, ANTHROPIC_API_KEY is set, and AI_CONSENT_EXTERNAL_PROCESSING=true
# (job text and non-identifying match facts are then sent to the Anthropic API).
# A Claude Code subscription does NOT include API credits - use a separate API key from console.anthropic.com.
ENABLE_AI_MATCHING=true
# true = the AI may re-classify which job skills are mandatory/preferred (can change scores). false = AI only words summaries; scores come from the rules.
AI_REFINE_JD=true
AI_CONSENT_EXTERNAL_PROCESSING=false
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT=60
CLAUDE_MAX_RETRIES=3
# Weights / thresholds / preferences / skill dictionary live in config/*.yaml
MAX_JD_CHARS=50000

# --- Document generation (Phase 5) ---
# Resumes, cover letters and screening answers are written from your verified profile WITHOUT any AI by default.
# Claude may only re-word them if ENABLE_AI_MATCHING=true, an API key is set AND you consent here
# (profile content - never your name or contact details - is then sent to the Anthropic API). Every AI text is
# fact-checked; unsupported claims are rejected and the deterministic text is used.
AI_DOCUMENTS_CONSENT=false
GENERATED_STORAGE_DIR=storage/generated
PDF_PAGE_SIZE=A4
MAX_DOCUMENT_CHARS=200000

# --- Phase 6: application execution (everything closed by default) ---
# Master switch. Even when true, only sites allowed in config/application_policies.yaml are automated; submitting always needs your approval.
APPLICATION_AUTOMATION_ENABLED=false
ALLOW_LOCAL_TEST_FORMS=false
BROWSER_HEADLESS=true
# "" = Playwright Chromium (falls back to installed Edge/Chrome); or msedge / chrome
BROWSER_CHANNEL=
BROWSER_TIMEOUT_MS=15000
SCREENSHOTS_DIR=storage/screenshots
# Encrypted browser sessions (cookies only; never passwords). Needs SECRET_KEY (16+ chars).
PERSIST_BROWSER_SESSIONS=false
SESSION_MAX_AGE_HOURS=12
MAX_SUBMIT_RETRIES=2

# --- Phase 7: scheduler, queue, notifications (all closed/off by default) ---
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_AUTOSTART=false
SCHEDULER_TICK_SECONDS=30
# Needed for any state-changing scheduler/queue/notification endpoint, approve/submit, Settings saves and the Automation page controls. Use a long random string.
# The API AND the web server both read it from THIS file, so setting it here is enough (restart both). It never reaches the browser.
ADMIN_TOKEN=
NOTIFICATIONS_ENABLED=false
NOTIFICATION_RECIPIENT=
# Encrypted Gmail OAuth credentials are stored by: uv run python scripts/gmail_setup.py  (needs SECRET_KEY, 16+ chars)
NOTIFICATION_CREDENTIALS_FILE=storage/notifications/gmail.cred

# --- Job-alert e-mails (Naukri alerts in YOUR Gmail, read-only Gmail API; nothing contacts naukri.com) ---
# Authorise once with: uv run python scripts/gmail_alerts_setup.py  (scope gmail.readonly; stored encrypted with SECRET_KEY)
JOB_ALERT_CREDENTIALS_FILE=storage/notifications/gmail_job_alerts.cred
# How many days of alert e-mails each discovery run looks at (jobs already stored are not added twice)
JOB_ALERT_LOOKBACK_DAYS=3

# --- Security / production (REQUIRED when APP_ENV=production; the API refuses to start without them) ---
# Generate each with:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN (above) must be 24+ characters in production. SECRET_KEY encrypts saved browser sessions, Gmail credentials and encrypted backups.
SECRET_KEY=
# Optional Gmail sender id ("me" = the authorised account)
GMAIL_SENDER=me
BROWSER_SLOW_MO_MS=0
BROWSER_SESSIONS_DIR=storage/browser_sessions

# --- Configuration files (relative to the project root; change only if you keep them elsewhere) ---
PLATFORM_POLICIES_FILE=config/platform_policies.yaml
APPLICATION_POLICIES_FILE=config/application_policies.yaml
CAREER_SOURCES_FILE=config/career_sources.yaml
JOB_PREFERENCES_FILE=config/job_preferences.yaml
SCORING_CONFIG_FILE=config/scoring_weights.yaml
AUTOMATION_LIMITS_FILE=config/automation_limits.yaml
SKILLS_FILE=config/skills.yaml

# --- Docker Compose only (read by docker-compose.yml; not application settings) ---
# MongoDB root account used by the compose database. Use URL-safe characters (letters, digits, - _ .): the password is embedded in MONGODB_URI.
MONGO_ROOT_USER=jobpilot
MONGO_ROOT_PASSWORD=
# true = install Playwright Chromium into the image (only if you authorise browser automation for specific sites)
INSTALL_BROWSER=false

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Relative paths are resolved from the project root
LOG_FILE=logs/app.log
